FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY publisher/requirements-gateway.lock /tmp/requirements.lock
RUN pip install --no-cache-dir pip==26.2.1 && pip install --no-cache-dir -r /tmp/requirements.lock
COPY publisher /srv/publisher
USER 1000:1000
EXPOSE 8900
CMD ["uvicorn","publisher.gateway:app","--host","0.0.0.0","--port","8900","--no-access-log","--no-proxy-headers"]
