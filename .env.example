# 字段参考，不要复制覆盖已有 .env。
# 首次初始化先运行 python scripts/configure.py，它会生成独立的 OPS_SECRET_KEY。
# 随后编辑已生成的 .env，按需要添加下面的字段。
OPS_ENVIRONMENT=development
OPS_TASK_MODE=local
OPS_PUBLIC_URL=http://127.0.0.1:8188
OPS_TEXT_PROVIDER=aliyun
OPS_DEEPSEEK_MODEL=deepseek-flash
OPS_DEEPSEEK_API_KEY=
OPS_ALIYUN_API_KEY=
OPS_ALIYUN_BASE_URL=https://dashscope.aliyuncs.com
OPS_ALIYUN_TEXT_BASE_URL=
OPS_OCR_ENABLED=false
OPS_ALLOW_LIVE_PUBLISH=false
OPS_ALLOW_LIVE_REPLIES=false
